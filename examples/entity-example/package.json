{
  "name": "jurassic-park-nodejs",
  "version": "1.0.0",
  "description": "Jurassic Park example using dyno-table and zod",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "debug": "tsx --inspect-brk src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "docker": "docker compose up -d",
    "check-types": "tsc --noEmit",
    "check-types:portable": "tsc -p tsconfig.portable.json",
    "verify": "pnpm run check-types && pnpm run check-types:portable"
  },
  "keywords": [
    "dyno-table",
    "zod",
    "dynamodb",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1106.0",
    "@aws-sdk/lib-dynamodb": "^3.1106.0",
    "dyno-table": "file:../../",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "tsx": "^4.23.12"
  }
}
